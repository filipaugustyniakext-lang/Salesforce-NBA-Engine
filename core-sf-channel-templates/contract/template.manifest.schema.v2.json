{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copy-center.example/schemas/template-manifest/v2",
  "title": "Copy Center component catalog",
  "description": "Generated by the template editor. Authors do not upload this file.",
  "type": "object",
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "label", "fileName"],
        "properties": {
          "type": {
            "enum": ["RichText", "Image", "TextImage", "Banner", "Prefooter", "Spacer"]
          },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string", "pattern": "^utility:[a-z0-9_]+$" },
          "fileName": { "type": "string" },
          "group": { "enum": ["Content", "Layout"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
