<apex:page standardController="Product2" recordSetVar="products" extensions="ProductMassUpdateController" lightningStylesheets="true">
    <apex:form >
        <apex:pageBlock title="Mass Update: Product Family">
            <apex:pageMessages />
            <apex:pageBlockButtons >
                <apex:commandButton value="Save Updates" action="{!updateProductFamilyDict}" />
                <apex:commandButton value="Cancel" action="{!cancel}" />
            </apex:pageBlockButtons>
            <apex:pageBlockSection columns="1">
                <apex:outputText value="Select the new Product Family for the {!selectedRecords.size} selected records:" />
                <apex:inputField value="{!dummyProduct.Product_Family_Dict__c}" required="true" />
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>
