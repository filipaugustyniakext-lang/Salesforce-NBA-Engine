<apex:page standardController="Product2" recordSetVar="products" extensions="ProductMassUpdateController" lightningStylesheets="true">
    <apex:form >
        <apex:pageBlock title="Mass Update: Family of Needs">
            <apex:pageMessages />
            <apex:pageBlockButtons >
                <apex:commandButton value="Save Updates" action="{!updateFamilyOfNeedsDict}" />
                <apex:commandButton value="Cancel" action="{!cancel}" />
            </apex:pageBlockButtons>
            <apex:pageBlockSection columns="1">
                <apex:outputText value="Select the new Family of Needs for the {!selectedRecords.size} selected records:" />
                <apex:inputField value="{!dummyProduct.Family_of_Needs_Dict__c}" required="true" />
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>