<aura:component implements="lightning:actionOverride,force:lightningQuickAction,force:hasRecordId,force:hasSObjectName">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="showWizard" type="Boolean" default="false" />
    <aura:attribute name="isVersionContext" type="Boolean" default="false" />

    <aura:if isTrue="{!v.showWizard}">
        <aura:if isTrue="{!v.isVersionContext}">
            <c:offerManager versionId="{!v.recordId}"></c:offerManager>
            <aura:set attribute="else">
                <c:offerManager recordId="{!v.recordId}"></c:offerManager>
            </aura:set>
        </aura:if>
    </aura:if>
</aura:component>
