<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Topic_Overall_Score__c</fullName>
    <description>70% loyalization + 30% ease</description>
    <externalId>false</externalId>
    <formula>(BLANKVALUE(Topic_Loyalization_Score__c, 0) * 0.70) + 
(BLANKVALUE(Topic_Ease_Score__c, 0) * 0.30)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Overall Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
