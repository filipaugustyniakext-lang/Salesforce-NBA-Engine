<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Timing_Evaluation_Type__c</fullName>
    <description>For Campaign Group records: whether campaigns in this group collect Duration (Days) or Validity (Days) in the Campaign Wizard.</description>
    <inlineHelpText>Duration measures how long a customer stays in the campaign. Validity measures how long the campaign action stays valid.</inlineHelpText>
    <label>Timing Evaluation Type</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Duration</fullName>
                <default>false</default>
                <label>Duration</label>
            </value>
            <value>
                <fullName>Validity</fullName>
                <default>false</default>
                <label>Validity</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
