    <decisions>
        <name>Check_Account_opening_date</name>
        <label>Check Account Opening Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Getdepositsavingsconfigurationdetails</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip conversation deletion</defaultConnectorLabel>
        <rules>
            <name>Account_opened_43_days_ago</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pa_opening_date__c</leftValueReference>
                <operator>LastNumberOfDays</operator>
                <rightValue>
                    <numberValue>43.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetACTIVEWelcomeCallconv</targetReference>
            </connector>
            <label>Account opened &lt; 43 days ago</label>
        </rules>
    </decisions>
