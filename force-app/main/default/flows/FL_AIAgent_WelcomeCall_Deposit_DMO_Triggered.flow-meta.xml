            <operator>EqualTo</operator>
            <value>
                <stringValue>wallet</stringValue>
            </value>
        </filters>
        <filters>
            <field>Welcome_Scenario__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>blik</stringValue>
            </value>
        </filters>
        <filters>
            <field>Welcome_Scenario__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>open-fx-account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Welcome_Scenario__c</field>
            <operator>EqualTo</operator>
